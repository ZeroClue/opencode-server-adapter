# Required. Set to a strong random value; this is the HTTP Basic password
# Paperclip will use to authenticate. The username is always "opencode".
OPENCODE_SERVER_PASSWORD=

# Host interface the container publishes its port on. Leave blank to bind all
# interfaces (0.0.0.0). Set to 127.0.0.1 if Paperclip is on the same host and
# you don't want the port reachable elsewhere.
OPENCODE_HOST=

# Port the container publishes 4096 on. Defaults to 4096.
OPENCODE_PORT=4096
