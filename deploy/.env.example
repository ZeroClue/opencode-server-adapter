# Required. Set to a strong random value; this is the HTTP Basic password
# Paperclip will use to authenticate. The username is always "opencode".
OPENCODE_SERVER_PASSWORD=

# opencode zen (provider "opencode") API key. This authenticates the models
# served by this container. Keep it out of VCS — this .env file is gitignored.
OPENCODE_API_KEY=

# Host interface the container publishes its ports on. Leave blank to bind all
# interfaces (0.0.0.0). Set to 127.0.0.1 if Paperclip is on the same host and
# you don't want the ports reachable elsewhere.
OPENCODE_HOST=

# Port the container publishes 4096 (serve) on. Defaults to 4096.
OPENCODE_PORT=4096

# Port the container publishes 2222 (in-container sshd for Paperclip sync) on.
# Defaults to 2222.
SSH_PORT=2222
