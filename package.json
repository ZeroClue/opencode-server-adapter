{
  "name": "@zeroclue/opencode-server-adapter",
  "version": "0.2.0",
  "description": "Paperclip adapter plugin that connects to a persistent opencode serve instance via its REST API",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./ui-parser": "./dist/ui-parser.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.529.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  },
  "files": [
    "dist",
    "src",
    "ui-parser.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.0",
  "paperclip": {
    "adapterUiParser": "1.0"
  }
}